# Example configuration for opentofu-codeartifact

aws_region   = "ap-northeast-1"
# aws_profile = "default"

domain_name   = "my-artifacts"
kms_key_alias = "my-artifacts-cmk"

repositories = [
  "dev",
  "stg",
  "prd"
]

default_tags = {
  Project     = "CodeArtifact"
  Environment = "Shared"
  ManagedBy   = "OpenTofu"
}
